{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["@playwright/test", "node", "jest"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "jest.setup.js",
    "helpers/global-setup.ts",
    "helpers/global-teardown.ts",
    "helpers/__mocks__/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
