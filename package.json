{
  "name": "rescate-animal-voluntariado",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:debug": "cross-env NODE_OPTIONS=\"--inspect=127.0.0.1:9229\" next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "restart-project": "node scripts/restart-project.js",
    "import-mock-users": "node scripts/create_users.js",
    "test:unit": "cross-env NODE_ENV=test jest",
    "test:api": "cross-env NODE_ENV=test jest --config=jest.config.api.js",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:sequential": "playwright test --workers=1",
    "test:e2e:login": "playwright test --project=login-tests",
    "test:e2e:roles-assignment": "playwright test --project=role-assignment-tests",
    "test:e2e:history": "playwright test --project=history-view-tests",
    "test:e2e:user-history": "playwright test --project=user-history-tests",
    "test:e2e:user-crud-tests": "playwright test --project=user-crud-tests",
    "test:e2e:admin": "playwright test --project=admin-features-tests",
    "test:e2e:sequence": "playwright test --project=login-tests --project=role-assignment-tests --project=history-view-tests",
    "test:e2e:ui": "playwright test --ui",
    "test:setup-env": "node -e \"require('./tests/helpers/setup-test-environment').setupTestEnvironment({requireUsers: true, requireShifts: true})\"",
    "test:cleanup-env": "node -e \"require('./tests/helpers/setup-test-environment').cleanupTestEnvironment()\"",
    "test:staged": "jest --passWithNoTests --bail --findRelatedTests $(git diff --staged --name-only)",
    "test:e2e:changed": "playwright test --grep-files $(git diff --staged --name-only)",
    "test": "npm run test:unit && npm run test:e2e",
    "test:all": "npm run test:unit:coverage && npm run test:e2e",
    "test:ci": "npm run test:unit -- --ci --silent",
    "killTasks": "taskkill /F /IM node.exe",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/cache": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.3.0",
    "@mui/material": "^6.3.0",
    "@mui/material-nextjs": "^6.3.0",
    "@mui/x-date-pickers": "^8.3.0",
    "@reduxjs/toolkit": "^2.7.0",
    "@vercel/analytics": "^1.5.0",
    "date-fns": "^4.1.0",
    "firebase": "^11.6.0",
    "firebase-admin": "^13.3.0",
    "next": "^15.3.1",
    "next-auth": "^4.24.11",
    "next-pwa": "^5.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.3",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/next-pwa": "^5.6.9",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "babel-jest": "^30.0.4",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jest": "^30.0.4",
    "jest-environment-jsdom": "^30.0.4",
    "lint-staged": "^16.1.2",
    "node-mocks-http": "^1.17.2",
    "playwright": "^1.52.0",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  }
}
